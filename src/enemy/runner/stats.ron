// Runner: fast, fragile, low loot. Steals scrap.
//
// Each spawn reads these values; wave scaling multiplies health and speed.
// A change applies to Runners spawned after it, not to those on the field.
(
    health: 30.0, // hit points
    speed: 80.0, // world units per second (a tile is 20)
    loot: 15, // scrap dropped on death, and the most it steals
)
